# --- Storage -----------------------------------------------------------
# SQLite by default. For PostgreSQL use e.g. postgresql+psycopg://user:pass@host/atm
DATABASE_URL=sqlite:///./data/atm.db
MODEL_DIR=./models

# --- Security ----------------------------------------------------------
# If set, every write endpoint requires header:  X-API-Key: <value>
API_KEY=
CORS_ORIGINS=*

# --- Business rules (same defaults as the notebook) --------------------
REORDER_THRESHOLD_PCT=20      # <= this % of capacity  -> "Refill Now"
MEDIUM_THRESHOLD_PCT=40       # <= this % of capacity  -> "Refill Soon"
CAPACITY_BUFFER=1.5           # default vault size = buffer x ATM's peak recommended loading
SAFETY_FACTOR=1.05            # recommended loading = predicted demand x this
ATM_MAX_LOADING=1500000       # hard cap on one recommended loading
CASH_UNIT=500                 # loads are rounded UP to a multiple of this
HIGH_DEMAND_PERCENTILE=75     # used for precision / recall / F1

# --- New operational knobs --------------------------------------------
SIM_REFILL_LEAD_DAYS=1        # simulation fallback: days between hitting the threshold and the refill
STALE_AFTER_DAYS=3            # ATM with no data for this many days (vs newest date) => "No Data"
WEEKEND_DAYS=4,5              # pandas dayofweek (Mon=0). 4,5 = Fri,Sat. The data shows Fri/Sat are lowest.
